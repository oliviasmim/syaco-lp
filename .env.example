# ATENÇÃO: toda variável VITE_ é gravada no JavaScript público da página.
# Nunca coloque aqui um segredo de verdade (token de API, senha, chave privada).
#
# Para onde vão os leads do formulário.
# Aceita qualquer endpoint que receba POST com JSON:
#   Planilha    → https://script.google.com/macros/s/xxxxxxx/exec  (ver README)
#   Formspree   → https://formspree.io/f/xxxxxxx
#   Web3Forms   → https://api.web3forms.com/submit  (+ VITE_FORM_KEY)
#   n8n webhook → https://seu-n8n/webhook/syaco-lead
#
# Sem esta variável, em desenvolvimento o formulário entra em modo demo
# (nada é enviado). Em produção ele mostra o erro com o link do WhatsApp.
VITE_FORM_ENDPOINT=

# Só para Web3Forms (vai no corpo como access_key). Deixe vazio nos outros.
VITE_FORM_KEY=

# Origem canônica, usada no canonical e no sitemap.
VITE_SITE_URL=https://syaco.com.br
